# ============ OS / editor ============
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ============ Secrets & credentials ============
# Never commit real credentials. Examples are committed instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
!.env.example
.aws/
.ssh/
secrets.tfvars

